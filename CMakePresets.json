{
  "version": 3,
  "buildPresets": [
    {
      "name": "_default_build",
      "hidden": true,
      "jobs": 23,
      "verbose": true
    }
  ],
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/bin/${presetName}",
      "installDir": "${sourceDir}/build/int/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/bin/${presetName}",
      "installDir": "${sourceDir}/build/bin-int/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "debug-windows",
      "displayName": "Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_CXX_FLAGS": "/Zc:preprocessor /Zc:__cplusplus /MDd /Od /DDEBUG /D_UTF8 /std:c++latest /EHsc- /W4 /permissive- /wd4996 /w14244 /w14265 /w14266 /w14302 /w14310 /w14388 /w14583 /w14640"
      }
    },
    {
      "name": "development-windows",
      "displayName": "Development",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_CXX_FLAGS": "/Zc:preprocessor /Zc:__cplusplus /MDd /O1 /DDEBUG /D_UTF8 /std:c++latest /EHsc- /W4 /permissive- /wd4996 /w14244 /w14265 /w14266 /w14302 /w14310 /w14388 /w14583 /w14640"
      }
    },
    {
      "name": "release-windows",
      "displayName": "Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_CXX_FLAGS": "/Zc:preprocessor /Zc:__cplusplus /MD /O2 /DDEBUG /D_UTF8 /std:c++latest /EHsc- /W4 /permissive- /wd4996 /w14244 /w14265 /w14266 /w14302 /w14310 /w14388 /w14583 /w14640"
      }
    },
    {
      "name": "debug-windows-clang",
      "displayName": "Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++.exe",
        "CMAKE_CXX_FLAGS": "-O0 -g -DDEBUG -fno-exceptions -std=c++2c -Wall -Wextra -Wpedantic -Walloca -Wcast-align -Wcast-qual -Wctor-dtor-privacy -Wdeprecated-copy-dtor -Wdouble-promotion -Wenum-conversion -Wextra-semi -Wfloat-equal -Wformat-signedness -Wformat=2 -Wmismatched-tags -Wmissing-braces -Wmultichar -Wnon-virtual-dtor -Woverloaded-virtual -Wpointer-arith -Wrange-loop-construct -Wshadow -Wuninitialized -Wvla -Wwrite-strings"
      }
    },
    {
      "name": "development-windows-clang",
      "displayName": "Development",
      "inherits": "windows-base",
      "cacheVariables": {
        "CXX_SCAN_FOR_MODULES": "1",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++.exe",
        "CMAKE_CXX_FLAGS": "-O2 -g -fno-exceptions -std=c++2c -Wall -Wextra -Wpedantic -Walloca -Wcast-align -Wcast-qual -Wctor-dtor-privacy -Wdeprecated-copy-dtor -Wdouble-promotion -Wenum-conversion -Wextra-semi -Wfloat-equal -Wformat-signedness -Wformat=2 -Wmismatched-tags -Wmissing-braces -Wmultichar -Wnon-virtual-dtor -Woverloaded-virtual -Wpointer-arith -Wrange-loop-construct -Wshadow -Wuninitialized -Wvla -Wwrite-strings"
      }
    },
    {
      "name": "release-windows-clang",
      "displayName": "Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CXX_SCAN_FOR_MODULES": "1",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++.exe",
        "CMAKE_CXX_FLAGS": "-O2 -fno-exceptions -std=c++2c -Wall -Wextra -Wpedantic -Walloca -Wcast-align -Wcast-qual -Wctor-dtor-privacy -Wdeprecated-copy-dtor -Wdouble-promotion -Wenum-conversion -Wextra-semi -Wfloat-equal -Wformat-signedness -Wformat=2 -Wmismatched-tags -Wmissing-braces -Wmultichar -Wnon-virtual-dtor -Woverloaded-virtual -Wpointer-arith -Wrange-loop-construct -Wshadow -Wuninitialized -Wvla -Wwrite-strings"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O0 -g -DDEBUG -fno-exceptions -std=c++2c -Wall -Wextra -Wpedantic -Walloca -Wcast-align -Wcast-qual -Wctor-dtor-privacy -Wdeprecated-copy-dtor -Wdouble-promotion -Wenum-conversion -Wextra-semi -Wfloat-equal -Wformat-signedness -Wformat=2 -Wmismatched-tags -Wmissing-braces -Wmultichar -Wnon-virtual-dtor -Woverloaded-virtual -Wpointer-arith -Wrange-loop-construct -Wshadow -Wuninitialized -Wvla -Wwrite-strings"
      }
    },
    {
      "name": "development-linux",
      "displayName": "Development",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-O2 -g -fno-exceptions -std=c++2c -Wall -Wextra -Wpedantic -Walloca -Wcast-align -Wcast-qual -Wctor-dtor-privacy -Wdeprecated-copy-dtor -Wdouble-promotion -Wenum-conversion -Wextra-semi -Wfloat-equal -Wformat-signedness -Wformat=2 -Wmismatched-tags -Wmissing-braces -Wmultichar -Wnon-virtual-dtor -Woverloaded-virtual -Wpointer-arith -Wrange-loop-construct -Wshadow -Wuninitialized -Wvla -Wwrite-strings"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O2 -fno-exceptions -std=c++2c -Wall -Wextra -Wpedantic -Walloca -Wcast-align -Wcast-qual -Wctor-dtor-privacy -Wdeprecated-copy-dtor -Wdouble-promotion -Wenum-conversion -Wextra-semi -Wfloat-equal -Wformat-signedness -Wformat=2 -Wmismatched-tags -Wmissing-braces -Wmultichar -Wnon-virtual-dtor -Woverloaded-virtual -Wpointer-arith -Wrange-loop-construct -Wshadow -Wuninitialized -Wvla -Wwrite-strings"
      }
    }
  ]
}

